# ────────────────────────────────────────────────────────────────────────────
# ConciliaAI — Variáveis de ambiente
# Copie para .env.local e preencha. No Vercel, configure as mesmas em
# Project → Settings → Environment Variables.
# ────────────────────────────────────────────────────────────────────────────

# Supabase (obrigatório para persistência)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJI...
# Service role: usada por endpoints server-side (NÃO expor no front!)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIc...

# Cron / segurança dos jobs Vercel (qualquer string aleatória forte)
CRON_SECRET=troque-por-uma-string-forte

# Setup automatizado (opcional, /api/setup)
VERCEL_TOKEN=
VERCEL_PROJECT_ID=conciliaai-ibs-cbs
SUPABASE_ANON_KEY_SETUP=

# ────────────────────────────────────────────────────────────────────────────
# Integrações fiscais (configuradas por empresa via UI ou diretamente em
# captura_sefaz_config / empresa.pfx_base64). Defaults globais opcionais:
# ────────────────────────────────────────────────────────────────────────────
# Ambiente padrão para chamadas ad-hoc (homologacao | producao)
SEFAZ_AMBIENTE_DEFAULT=homologacao

# Limites operacionais
SEFAZ_POLL_LIMIT_LOTES=20
NFSE_POLL_LIMIT_PAGINAS=50
